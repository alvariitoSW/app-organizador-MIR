<?xml version="1.0" encoding="utf-8"?>
<!-- Sin permiso de INTERNET (el workflow falla si aparece): los datos solo pasan de Android a Brave dentro del móvil. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
      tools:ignore="ProtectedPermissions" />

  <!-- Sitios (T1): ubicación en segundo plano, calculada en el móvil -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- Android 11+: ver Brave, la pantalla de inicio y el nombre de las apps del cajón -->
  <queries>
    <package android:name="com.brave.browser" />
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
  </queries>

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:allowBackup="false"
      android:usesCleartextTraffic="false"
      android:theme="@android:style/Theme.Material.NoActionBar">
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:excludeFromRecents="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
    </activity>
    <!-- Sitios (T1): la pantalla, el vigía en primer plano y el arranque tras reiniciar -->
    <activity
        android:name=".SitiosActivity"
        android:exported="false"
        android:taskAffinity="es.guardias.lanzador.sitios" />
    <service
        android:name=".Vigia"
        android:exported="false"
        android:foregroundServiceType="location" />
    <receiver
        android:name=".Arranque"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
    <!-- K4: el widget de inicio (2×2, 4 atajos). Sin red. -->
    <receiver
        android:name=".Atajos"
        android:exported="true"
        android:label="@string/widget_nombre">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_atajos_info" />
    </receiver>
  </application>
</manifest>
